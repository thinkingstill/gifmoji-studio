{
  "name": "gifmoji-studio",
  "version": "1.0.0",
  "private": true,
  "description": "基于混元图像模型与 FFmpeg 的 GIF 表情工坊",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test/smoke.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "sync:docs": "node scripts/sync-docs.mjs",
    "test:unit": "node --test test/giflite.test.mjs",
    "test:all": "node --test test/giflite.test.mjs && node test/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ipaddr.js": "^2.5.0",
    "multer": "^2.0.2",
    "sharp": "^0.35.5",
    "yazl": "^3.3.1"
  }
}
